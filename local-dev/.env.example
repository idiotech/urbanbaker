# Copy to .env and adjust. Every setting has a default; .env only overrides.

# Where the ghostspeak-agent, ghostspeak-auth and ghostspeak-editor checkouts are.
# Default: the folder that holds urbanbaker.
#GHOSTSPEAK_HOME=/home/you/Projects

# The Firebase service-account JSON the agent sends push messages with.
# Missing, the agent still starts; its first push fails.
#FCM_KEY_FILE=./secrets/fcm.json

# The JDK sbt runs on for bin/agent and bin/auth (17 to 23).
#SBT_JAVA_HOME=/home/you/.jdks/graalvm-ce-23.0.2
